# Database settings
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=db
DB_PORT=5432

# Django settings
SECRET_KEY=your_django_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,backend:8000

# Redis/Celery settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ModelArts API settings
HUAWEICLOUD_SDK_AK=your_huawei_cloud_ak
HUAWEICLOUD_SDK_SK=your_huawei_cloud_sk
MODELARTS_ENDPOINT_URL=https://your-modelarts-endpoint-url

# Frontend settings
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
BACKEND_API_URL=http://backend:8000/api
